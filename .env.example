# Infrastructure settings for twin-server. Copy to .env to override defaults.
# Business configuration lives in config/*.yaml, not here.

ENVIRONMENT=local
HOST=127.0.0.1
PORT=8000

# Paths are relative to the repository root.
CONFIG_DIR=config
DATA_DIR=data
# Defaults to sqlite:///<DATA_DIR>/workplace.db
# DATABASE_URL=

# Adapter selection (only "memory" exists in the light setup).
EVENT_BUS=memory
STATE_STORE=memory

LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
HEARTBEAT_INTERVAL_S=30
